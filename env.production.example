# Copy to /opt/apivexo/server/.env on the VPS (do not commit secrets)
PORT=5001
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?appName=apivexo
MONGODB_DB_NAME=user_dashboard
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-openssl-rand-hex-32
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=2h
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=StrongPasswordHere
SUPER_ADMIN_NAME=Super Admin
CLIENT_ORIGIN=https://apivexo.com
API_SECRET_PEPPER=replace-with-openssl-rand-hex-16
GAME_LAUNCH_UPSTREAM_URL=https://txserver.site/tgamelaunch.php
GAME_LAUNCH_AGENCY_UID=0b98f74aa493413ce882a9edef9f9ede
GET_WITHDRAW_UPSTREAM_URL=https://txserver.site/tgetwithdraw.php
GET_WITHDRAW_AGENCY_UID=d5806564bab3b30e0eba2148ebb8e7bd
# Optional. If set, POST /api/v1/ggr/settle-month accepts header x-cron-secret.
CRON_SECRET=
# Required for PHP Huidu callback → POST /api/game/v1/callback/settle
GAME_CALLBACK_SECRET=
