{
  "name": "user-dashboard-server",
  "version": "1.0.0",
  "private": true,
  "description": "Multirole dashboard API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seed/run.ts",
    "seed:games": "tsx src/seed/run-games.ts",
    "seed:quotations": "tsx src/seed/run-quotations.ts",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
