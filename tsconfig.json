{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": ["src/**/*"],
  // Local-only seed dumps and their runners. Seed with tsx, not the Docker tsc build.
  "exclude": [
    "node_modules",
    "dist",
    "src/data/**",
    "src/seed/run-games.ts",
    "src/seed/run-quotations.ts",
    "src/seed/seeders/gameCatalogue.seeder.ts",
    "src/seed/seeders/apiQuotation.seeder.ts"
  ]
}
